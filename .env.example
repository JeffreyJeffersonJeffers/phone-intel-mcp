DATABASE_URL=
TWILIO_SID=
TWILIO_TOKEN=
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=
IPQS_API_KEY=
CDP_API_KEY=
CDP_API_SECRET=
# Only read by scripts/create-wallet.ts, never by the server.
CDP_WALLET_SECRET=
WALLET_ADDRESS=
# Keys the HMAC behind phone_hash in the logs, so a leaked log cannot be matched against a table of
# all US numbers. REQUIRED in production (the server refuses to start without it); at least 32
# characters. Generate one with:  openssl rand -hex 32
# Outside production a random per-process key is used if this is unset (with a warning).
LOG_PHONE_HMAC_KEY=
PORT=8080
NODE_ENV=development
