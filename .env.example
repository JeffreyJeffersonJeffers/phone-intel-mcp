DATABASE_URL=
TWILIO_SID=
TWILIO_TOKEN=
YELP_API_KEY=
# Optional, and only together. Yelp refuses requests from datacenter IPs (Fly.io's included), so in
# production Yelp calls go through our own proxy on Vercel (the phone-intel-yelp-proxy project), which
# holds the Yelp key itself. YELP_PROXY_URL is its base URL, e.g. https://phone-intel-yelp-proxy.vercel.app,
# and YELP_PROXY_AUTH is the secret it checks in the X-Proxy-Auth header (its PROXY_AUTH_SECRET on
# Vercel). If either is empty, Yelp is called directly with YELP_API_KEY, which is fine from a home or
# office connection. With both set, YELP_API_KEY is not used.
YELP_PROXY_URL=
YELP_PROXY_AUTH=
GOOGLE_PLACES_API_KEY=
IPQS_API_KEY=
CDP_API_KEY=
CDP_API_SECRET=
# Only read by scripts/create-wallet.ts, never by the server.
CDP_WALLET_SECRET=
WALLET_ADDRESS=
# Keys the HMAC behind phone_hash in the logs, so a leaked log cannot be matched against a table of
# all US numbers. REQUIRED in production (the server refuses to start without it); at least 32
# characters. Generate one with:  openssl rand -hex 32
# Outside production a random per-process key is used if this is unset (with a warning).
LOG_PHONE_HMAC_KEY=
PORT=8080
NODE_ENV=development
