DATABASE_URL=
TWILIO_SID=
TWILIO_TOKEN=
YELP_API_KEY=
# Optional. Yelp refuses requests from datacenter IPs (Fly.io's included), so in production Yelp calls
# go through ScraperAPI when this is set: sign up for a key at https://www.scraperapi.com (a 7-day trial
# of 5,000 credits, then a free plan of 1,000 credits and 5 concurrent connections; one uncached Yelp
# lookup costs one credit). Leave it empty to call Yelp directly, which is fine from a home or office
# connection.
SCRAPERAPI_KEY=
GOOGLE_PLACES_API_KEY=
IPQS_API_KEY=
CDP_API_KEY=
CDP_API_SECRET=
# Only read by scripts/create-wallet.ts, never by the server.
CDP_WALLET_SECRET=
WALLET_ADDRESS=
# Keys the HMAC behind phone_hash in the logs, so a leaked log cannot be matched against a table of
# all US numbers. REQUIRED in production (the server refuses to start without it); at least 32
# characters. Generate one with:  openssl rand -hex 32
# Outside production a random per-process key is used if this is unset (with a warning).
LOG_PHONE_HMAC_KEY=
PORT=8080
NODE_ENV=development
